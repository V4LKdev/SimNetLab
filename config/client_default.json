{
  "transport": {
    "host": "127.0.0.1",
    "port": 7777,
    "max_clients": 1,
    "max_payload_bytes": 1200,
    "send_size_policy": "allow_backend_fragmentation",
    "snapshot_delivery": "reliable_sequenced"
  },
  "gameplay": {
    "role": "stationary_observer"
  },
  "visualization": {
    "enabled": false,
    "interpolation_enabled": true,
    "window_width": 1800,
    "window_height": 1080,
    "panel_width": 420,
    "target_fps": 60,
    "entity_scale": 1.0,
    "picking_radius": 1.0,
    "stationary_observer_interest_radius": 150.0,
    "stationary_observer_vertical_fov_degrees": 60.0,
    "max_visible_spatial_cells": 2048,
    "entity_mesh_path": ""
  },
  "telemetry": {
    "console_log_enabled": true,
    "file_log_enabled": true,
    "log_directory": "logs",
    "min_level": "info",
    "metrics_csv_enabled": true
  }
}
