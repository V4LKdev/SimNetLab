{
  "transport": {
    "host": "127.0.0.1",
    "port": 7777,
    "max_clients": 1,
    "max_payload_bytes": 1200,
    "send_size_policy": "allow_backend_fragmentation",
    "snapshot_delivery": "reliable_sequenced"
  },
  "visualization": {
    "enabled": true,
    "window_width": 1800,
    "window_height": 1080,
    "panel_width": 360,
    "target_fps": 60,
    "entity_scale": 1.0,
    "picking_radius": 1.0
  },
  "telemetry": {
    "tracy_enabled": false,
    "console_log_enabled": true,
    "file_log_enabled": true,
    "log_directory": "logs",
    "min_level": "info",
    "metrics_csv_enabled": true,
    "metrics_json_enabled": false
  }
}
